{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Braidpipe Playbook",
  "type": "object",
  "required": [
    "version",
    "source",
    "destination"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1"
      ],
      "description": "Playbook schema version"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for this braid"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "generator",
            "stdin",
            "http"
          ]
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ]
    },
    "transform": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "filter",
              "rename",
              "select"
            ]
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stdout"
          ]
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ]
    }
  }
}